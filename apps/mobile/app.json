{
  "expo": {
    "name": "Transit Hide and Seek",
    "slug": "transit-hide-and-seek",
    "version": "0.1.0",
    "scheme": "transithideseek",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-router",
      "expo-sharing",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow $(PRODUCT_NAME) to share your position with your team during an active game.",
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to keep your team's positions up to date while you switch apps or lock your phone during an active game.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.transithideseek.mobile"
    },
    "web": {
      "bundler": "metro"
    }
  }
}
